   "source": [
    "## Celda 3 — Organizar el dataset por clases\n",
    "\n",
    "El dataset viene en formato PASCAL VOC (imágenes + XMLs de anotaciones).\n",
    "Lo reorganizamos en carpetas `con_casco/` y `sin_casco/` para poder usarlo con Keras."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import xml.etree.ElementTree as ET\n",
    "from PIL import Image\n",
    "import random\n",
    "\n",
    "# Directorios del dataset original\n",
    "IMAGES_DIR = '/content/helmets_raw/images'\n",
    "ANNOT_DIR  = '/content/helmets_raw/annotations'\n",
    "\n",
    "# Directorios destino organizados por clase\n",
    "BASE_DIR     = '/content/helmets_dataset'\n",
    "TRAIN_DIR    = os.path.join(BASE_DIR, 'train')\n",
    "VAL_DIR      = os.path.join(BASE_DIR, 'val')\n",
    "TEST_DIR     = os.path.join(BASE_DIR, 'test')\n",
    "\n",
    "for split in [TRAIN_DIR, VAL_DIR, TEST_DIR]:\n",
    "    for cls in ['con_casco', 'sin_casco']:\n",
    "        os.makedirs(os.path.join(split, cls), exist_ok=True)\n",
    "\n",
    "def tiene_casco(xml_path):\n",
    "    \"\"\"Lee el XML y determina si la imagen contiene una persona con casco.\"\"\"\n",
    "    try:\n",
    "        tree = ET.parse(xml_path)\n",
    "        root = tree.getroot()\n",
    "        labels = [obj.find('name').text.lower() for obj in root.findall('object')]\n",
    "        # 'helmet' = con casco, 'head' o 'person' sin casco\n",
    "        tiene = any('helmet' in l for l in labels)\n",
    "        sin   = any(l in ['head', 'person'] for l in labels)\n",
    "        if tiene and not sin:\n",
    "            return 'con_casco'\n",
    "        elif sin and not tiene:\n",
    "            return 'sin_casco'\n",
    "        else:\n",
    "            return None  # Mixto, descartamos\n",
    "    except:\n",
    "        return None\n",
    "\n",
    "# Procesar todas las imágenes\n",
    "con_casco_imgs = []\n",
    "sin_casco_imgs = []\n",
    "\n",
    "xml_files = [f for f in os.listdir(ANNOT_DIR) if f.endswith('.xml')]\n",
    "\n",
    "for xml_file in xml_files:\n",
    "    xml_path = os.path.join(ANNOT_DIR, xml_file)\n",
    "    img_name = xml_file.replace('.xml', '.png')\n",
    "    img_path = os.path.join(IMAGES_DIR, img_name)\n",
    "\n",
    "    if not os.path.exists(img_path):\n",
    "        img_name = xml_file.replace('.xml', '.jpg')\n",
    "        img_path = os.path.join(IMAGES_DIR, img_name)\n",
    "\n",
    "    if not os.path.exists(img_path):\n",
    "        continue\n",
    "\n",
    "    clase = tiene_casco(xml_path)\n",
    "    if clase == 'con_casco':\n",
    "        con_casco_imgs.append(img_path)\n",
    "    elif clase == 'sin_casco':\n",
    "        sin_casco_imgs.append(img_path)\n",
    "\n",
    "print(f'Imágenes con casco:  {len(con_casco_imgs)}')\n",
    "print(f'Imágenes sin casco:  {len(sin_casco_imgs)}')\n",
    "\n",
    "# Balancear clases\n",
    "min_count = min(len(con_casco_imgs), len(sin_casco_imgs))\n",
    "random.seed(42)\n",
    "con_casco_imgs = random.sample(con_casco_imgs, min_count)\n",
    "sin_casco_imgs = random.sample(sin_casco_imgs, min_count)\n",
    "\n",
    "def copiar_split(imgs, clase, split_dir, start, end):\n",
    "    subset = imgs[start:end]\n",
    "    dest = os.path.join(split_dir, clase)\n",
    "    for i, src in enumerate(subset):\n",
    "        ext = os.path.splitext(src)[1]\n",
    "        dst = os.path.join(dest, f'{clase}_{i:04d}{ext}')\n",
    "        shutil.copy(src, dst)\n",
    "\n",
    "# Split 80/10/10\n",
    "n = min_count\n",
    "t80 = int(n * 0.8)\n",
    "t90 = int(n * 0.9)\n",
    "\n",
    "for imgs, clase in [(con_casco_imgs, 'con_casco'), (sin_casco_imgs, 'sin_casco')]:\n",
    "    copiar_split(imgs, clase, TRAIN_DIR, 0,   t80)\n",
    "    copiar_split(imgs, clase, VAL_DIR,   t80, t90)\n",
    "    copiar_split(imgs, clase, TEST_DIR,  t90, n)\n",
    "\n",
    "print(f'\\n✅ Dataset organizado:')\n",
    "for split, d in [('Train', TRAIN_DIR), ('Val', VAL_DIR), ('Test', TEST_DIR)]:\n",
    "    cc = len(os.listdir(os.path.join(d, 'con_casco')))\n",
    "    sc = len(os.listdir(os.path.join(d, 'sin_casco')))\n",
    "    print(f'   {split}: {cc} con casco | {sc} sin casco')"
   ]
  },
  {
   "cell_type": "markdown",
